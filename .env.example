# Copy to .env and edit. Everything is optional - burstai works fully offline-capable without any key.

# Optional: Gemini free-tier key adds a third-opinion LLM judge to AI detection.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Language models for the Binoculars / perplexity signals (must share a tokenizer).
# Defaults are small (~900 MB total) and run on CPU. Stronger pairs if you have the VRAM / bandwidth:
#   BURSTAI_OBSERVER_MODEL=gpt2            BURSTAI_PERFORMER_MODEL=gpt2-medium        (~2 GB)
#   BURSTAI_OBSERVER_MODEL=Qwen/Qwen2.5-1.5B   BURSTAI_PERFORMER_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Run `bash scripts/download_models.sh` to fetch the defaults into ./models with resumable downloads.
BURSTAI_OBSERVER_MODEL=distilgpt2
BURSTAI_PERFORMER_MODEL=gpt2
BURSTAI_USE_BINOCULARS=1
BURSTAI_DEVICE=auto

# Web search breadth (more = slower, finds more sources)
BURSTAI_SEARCH_MAX_QUERIES=10
BURSTAI_SEARCH_RESULTS_PER_QUERY=4

# Self-hosted LanguageTool (docker run -p 8010:8010 erikvl87/languagetool) removes the public rate limit.
# LANGUAGETOOL_URL=http://localhost:8010/v2/check

BURSTAI_HOST=127.0.0.1
BURSTAI_PORT=8000
