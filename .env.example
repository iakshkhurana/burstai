# Copy to .env and edit. Everything is optional: BurstAI works without any key.
# Never commit .env.

# --- Deployment mode -------------------------------------------------------------------------
# Leave BURSTAI_ENGINE_TOKEN empty to run stand-alone (this server also serves the site).
# Set it (long, random) to run engine-only behind the Cloudflare Worker; use the same value as the
# Worker secret ENGINE_TOKEN. It is also the signing key for results, so rotating it invalidates
# existing signed reports.
BURSTAI_ENGINE_TOKEN=
# The public site that scripts/start_engine.ps1 registers this engine's tunnel address with.
BURSTAI_SITE_URL=
# Canonical URL when this Python server serves the site itself (stand-alone mode).
BURSTAI_PUBLIC_URL=

# --- Language models (AI-writing likelihood; English only) -------------------------------------
# The pair must share a tokenizer. Defaults are small (~900 MB) and run on CPU.
# Fetch them with: bash scripts/download_models.sh
# If you change the pair, re-run `python -m tests.calibrate` and update app/aidetect/engine.py.
BURSTAI_OBSERVER_MODEL=distilgpt2
BURSTAI_PERFORMER_MODEL=gpt2
BURSTAI_USE_BINOCULARS=1
BURSTAI_DEVICE=auto

# --- Web search breadth (more = slower, finds more sources) ------------------------------------
BURSTAI_SEARCH_MAX_QUERIES=10
BURSTAI_SEARCH_RESULTS_PER_QUERY=4

# --- Fair-use limits per visitor ----------------------------------------------------------------
BURSTAI_RATE_SCANS_PER_HOUR=30
BURSTAI_RATE_SCANS_PER_MIN=6

# --- Grammar ------------------------------------------------------------------------------------
# The public LanguageTool endpoint is rate-limited and meant for light use. For real traffic:
#   docker run -p 8010:8010 erikvl87/languagetool
# LANGUAGETOOL_URL=http://localhost:8010/v2/check

# --- Optional Gemini (normally each user adds their own key in the browser instead) -------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

BURSTAI_HOST=127.0.0.1
BURSTAI_PORT=8000
